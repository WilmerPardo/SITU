DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,situ.azurewebsites.net
CSRF_TRUSTED_ORIGINS=https://situ.azurewebsites.net
DATABASE_URL=postgresql://usuario:password@servidor.postgres.database.azure.com:5432/situ
DB_SSL_MODE=require
DB_CONN_MAX_AGE=600
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0

# Alternativa a DATABASE_URL si usas Azure Service Connector para PostgreSQL.
AZURE_POSTGRESQL_NAME=
AZURE_POSTGRESQL_USER=
AZURE_POSTGRESQL_PASSWORD=
AZURE_POSTGRESQL_HOST=
AZURE_POSTGRESQL_PORT=5432

# Opcional: usa Azure Blob Storage para las imagenes subidas.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=media
AZURE_STORAGE_URL_EXPIRATION_SECS=3600

# Opcional: si no usas Blob Storage, guarda media en disco persistente de App Service.
DJANGO_MEDIA_ROOT=/home/site/media

# Azure App Service / Oryx.
SCM_DO_BUILD_DURING_DEPLOYMENT=1
RUN_MIGRATIONS_ON_STARTUP=0
